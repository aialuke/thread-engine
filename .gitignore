__pycache__/
*.py[cod]
.DS_Store
.venv/

# Human approval markers are local state, never committed
APPROVED

# Loop scratch payloads, and the pid lock writers share
loop/inbox/
.write.lock

# Saved x_read results, so a crashed search is not fetched twice
ledger/x-read-cache/

# X API raw responses and follower ids: other people's data, kept on this Mac only
ledger/raw/api/
loop/followers/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Jev referee: captured prompts can contain whatever the operator pasted.
# Local policy may only tighten the committed thresholds.
receipts/prompts/
jev/thresholds.local.yaml
