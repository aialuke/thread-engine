<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily X API read for thread-engine.
  Runs scripts/snapshot.py once a day at 20:00 local time. It reads the account's
  own posts, replies, followers and mentions through scripts/x_api.py with the
  read-only keys in the login Keychain. Read cursors mean a missed day (Mac asleep
  or off) leaves no gap; the next run reads those posts late. If the Mac is asleep
  at 20:00, launchd runs it on wake.
  Only the script writes ledger/ and loop/, through loop.py, then commits. Cost per
  run is appended to ledger/runs.log.
  Log: ~/Library/Logs/thread-engine-snapshot.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.exitzerocode.thread-engine.snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/src/thread-engine" &amp;&amp; echo "== $(date -u +%FT%TZ)" &amp;&amp; python3 scripts/snapshot.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/lukemckenzie/Library/Logs/thread-engine-snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lukemckenzie/Library/Logs/thread-engine-snapshot.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
